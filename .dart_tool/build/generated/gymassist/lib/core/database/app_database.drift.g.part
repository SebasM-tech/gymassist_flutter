      required this.joinedAt,
      this.membershipStart,
      this.membershipEnd,
      required this.missedCount});
  @override
  Map<String, Expression> toColumns(bool nullToAbsent) {
    final map = <String, Expression>{};
    map['created_at'] = Variable<DateTime>(createdAt);
    map['updated_at'] = Variable<DateTime>(updatedAt);
    if (!nullToAbsent || deletedAt != null) {
      map['deleted_at'] = Variable<DateTime>(deletedAt);
    }
    map['id'] = Variable<String>(id);
    map['user_id'] = Variable<String>(userId);
    map['gym_id'] = Variable<String>(gymId);
    if (!nullToAbsent || planId != null) {
      map['plan_id'] = Variable<String>(planId);
    }
    map['full_name'] = Variable<String>(fullName);
    map['document_id'] = Variable<String>(documentId);
    map['phone'] = Variable<String>(phone);
    {
      map['status'] =
          Variable<String>($ClientsTable.$converterstatus.toSql(status));
    }
    map['joined_at'] = Variable<DateTime>(joinedAt);
    if (!nullToAbsent || membershipStart != null) {
      map['membership_start'] = Variable<DateTime>(membershipStart);
    }
    if (!nullToAbsent || membershipEnd != null) {
      map['membership_end'] = Variable<DateTime>(membershipEnd);
    }
    map['missed_count'] = Variable<int>(missedCount);
    return map;
  }

  ClientsCompanion toCompanion(bool nullToAbsent) {
    return ClientsCompanion(
      createdAt: Value(createdAt),
      updatedAt: Value(updatedAt),
      deletedAt: deletedAt == null && nullToAbsent
          ? const Value.absent()
          : Value(deletedAt),
      id: Value(id),
      userId: Value(userId),
      gymId: Value(gymId),
      planId:
          planId == null && nullToAbsent ? const Value.absent() : Value(planId),
      fullName: Value(fullName),
      documentId: Value(documentId),
      phone: Value(phone),
      status: Value(status),
      joinedAt: Value(joinedAt),
      membershipStart: membershipStart == null && nullToAbsent
          ? const Value.absent()
          : Value(membershipStart),
      membershipEnd: membershipEnd == null && nullToAbsent
          ? const Value.absent()
          : Value(membershipEnd),
      missedCount: Value(missedCount),
    );
  }

